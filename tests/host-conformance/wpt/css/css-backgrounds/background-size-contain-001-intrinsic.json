{
  "schema": 1,
  "id": "wpt.css-backgrounds.background-size-contain-001-intrinsic",
  "upstream": {
    "repository": "https://github.com/web-platform-tests/wpt",
    "revision": "db80bd24a77f1b5f8ba40a5b320dec3720a37c8d",
    "path": "css/css-backgrounds/background-size-contain-001.html",
    "reference_path": "reference/ref-filled-green-100px-square.xht",
    "license": "BSD-3-Clause",
    "assertion": "Contain scales a raster to the largest size that fits the positioning area while preserving intrinsic aspect ratio.",
    "adaptation": "The external image is replaced by a deterministic 4x2 raster in a 100x80 box. Centered pixel samples verify the resulting 100x50 tile, its orientation, and the uncovered bands."
  },
  "test": {
    "commands": [
      { "type": "attach_surface", "width": 100.0, "height": 80.0, "scale": 1.0 },
      {
        "type": "register_raster_resource", "id": 1, "width": 4, "height": 2,
        "pixels": [
          { "kind": "srgba", "red": 255, "green": 0, "blue": 0, "alpha": 1.0 }, { "kind": "srgba", "red": 255, "green": 0, "blue": 0, "alpha": 1.0 },
          { "kind": "srgba", "red": 0, "green": 128, "blue": 0, "alpha": 1.0 }, { "kind": "srgba", "red": 0, "green": 128, "blue": 0, "alpha": 1.0 },
          { "kind": "srgba", "red": 0, "green": 0, "blue": 255, "alpha": 1.0 }, { "kind": "srgba", "red": 0, "green": 0, "blue": 255, "alpha": 1.0 },
          { "kind": "srgba", "red": 255, "green": 255, "blue": 0, "alpha": 1.0 }, { "kind": "srgba", "red": 255, "green": 255, "blue": 0, "alpha": 1.0 }
        ]
      },
      {
        "type": "present_scene", "revision": 1,
        "nodes": [{
          "id": 1, "parent": null, "rect": [0.0, 0.0, 100.0, 80.0],
          "background": { "kind": "srgba", "red": 128, "green": 128, "blue": 128, "alpha": 1.0 },
          "background_layers": [{
            "geometry": {
              "position": [{ "length": 0.0, "fraction": 0.5 }, { "length": 0.0, "fraction": 0.5 }],
              "size": "contain", "repeat_x": "no_repeat", "repeat_y": "no_repeat"
            },
            "image": { "resource": 1 }
          }]
        }]
      },
      {
        "type": "checkpoint", "name": "paint.background-layers.size-contain",
        "samples": [
          { "point": [50.0, 5.0], "color": { "kind": "srgba", "red": 128, "green": 128, "blue": 128, "alpha": 1.0 }, "tolerance": 5 },
          { "point": [20.0, 25.0], "color": { "kind": "srgba", "red": 255, "green": 0, "blue": 0, "alpha": 1.0 }, "tolerance": 5 },
          { "point": [80.0, 25.0], "color": { "kind": "srgba", "red": 0, "green": 128, "blue": 0, "alpha": 1.0 }, "tolerance": 5 },
          { "point": [20.0, 55.0], "color": { "kind": "srgba", "red": 0, "green": 0, "blue": 255, "alpha": 1.0 }, "tolerance": 5 },
          { "point": [80.0, 55.0], "color": { "kind": "srgba", "red": 255, "green": 255, "blue": 0, "alpha": 1.0 }, "tolerance": 5 },
          { "point": [50.0, 75.0], "color": { "kind": "srgba", "red": 128, "green": 128, "blue": 128, "alpha": 1.0 }, "tolerance": 5 }
        ]
      }
    ]
  }
}
