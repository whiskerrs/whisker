// Emulator-only demo project. Do not deploy these permissive test rules.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /smoke/{document=**} { allow read, write: if true; }
    match /{path=**}/items/{item} { allow read: if true; }
    match /users/{uid} { allow read, write: if request.auth != null && request.auth.uid == uid; }
  }
}
