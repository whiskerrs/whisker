<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Whisker.WindowsHost</id>
    <version>$version$</version>
    <authors>Whisker contributors</authors>
    <license type="expression">MIT OR Apache-2.0</license>
    <projectUrl>https://github.com/whiskerrs/whisker</projectUrl>
    <description>WinUI 3 Host for Whisker applications: presents frames from the Rust runtime through the mobile C ABI.</description>
    <tags>whisker winui native</tags>
    <dependencies>
      <group targetFramework="native0.0">
        <dependency id="Microsoft.WindowsAppSDK.Foundation" version="[2.6.5]" />
        <dependency id="Microsoft.WindowsAppSDK.InteractiveExperiences" version="[2.6.5]" />
        <dependency id="Microsoft.WindowsAppSDK.WinUI" version="[2.6.5]" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="nuget\build\native\Whisker.WindowsHost.targets" target="build\native" />
    <file src="WhiskerHost\include\whisker\*.h" target="build\native\include\whisker" />
    <file src="x64\Release\WhiskerHost.lib" target="build\native\lib\x64" />
    <file src="ARM64\Release\WhiskerHost.lib" target="build\native\lib\ARM64" />
  </files>
</package>
